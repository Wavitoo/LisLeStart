# Copier vers .env (fait automatiquement par scripts/setup.sh). Ne jamais commiter .env.

# PostgreSQL (docker compose)
POSTGRES_USER=lislestart
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=lislestart
DATABASE_URL=postgresql://lislestart:change-me-local-only@localhost:5432/lislestart

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
# Généré par scripts/setup.sh
SESSION_SECRET=

# Connecteur start.gg (jeton personnel, facultatif en local : les tests utilisent des mocks)
STARTGG_API_TOKEN=

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Simulateur
SIMULATOR_SEED=42
